# Test tiers, areas and needs (docs/TESTING.md; the family's CI strategy, CraigHutchinson/.github docs/ci-strategy.md).
#
# Every ctest test carries exactly one TIER label and one AREA label, and any NEEDS it has:
#   tier   smoke  fast, no hardware: CI on every push (`ctest --preset quick`)
#          full   long suites: CI at the quality gates (`ctest --preset full`)
#          local  needs this machine (a GPU, a backend, the network): never scheduled by CI (`ctest --preset local`)
#   area:<name>   which layer or concern the test covers
#   needs:<gpu|backend|network|admin>   what it needs; any needs forces tier local, and needs:gpu takes the gpu resource lock
#   cost:slow     a long test inside its tier
# Label grammar and rules are kept free of anything engine-specific so they can be lifted into the family's shared spec.
include_guard(GLOBAL)

set(SUB0ENGINE_TEST_TIERS smoke full local)
set(SUB0ENGINE_TEST_AREAS structure platform net contracts evidence backends supervision fit registry control service reference tooling)
set(SUB0ENGINE_TEST_NEEDS gpu backend network admin)

# sub0engine_label_tests(AREA x TIER t [NEEDS gpu ...] [SLOW] TARGETS name...)
function(sub0engine_label_tests)
  cmake_parse_arguments(L "SLOW" "AREA;TIER" "NEEDS;TARGETS" ${ARGN})
  foreach(test ${L_TARGETS})
    if(NOT TEST ${test})
      continue()
    endif()
    set(labels ${L_TIER} "area:${L_AREA}")
    foreach(n ${L_NEEDS})
      list(APPEND labels "needs:${n}")
      if(n STREQUAL "gpu")
        set_property(TEST ${test} PROPERTY RESOURCE_LOCK gpu)
      endif()
    endforeach()
    if(L_SLOW)
      list(APPEND labels "cost:slow")
    endif()
    set_property(TEST ${test} APPEND PROPERTY LABELS ${labels})
  endforeach()
endfunction()

# Checked after every add_test: a new test cannot be left out.
function(sub0engine_check_labels)
  get_property(allTests DIRECTORY ${CMAKE_SOURCE_DIR} PROPERTY TESTS)
  set(bad "")
  string(REPLACE ";" "|" tierRe "${SUB0ENGINE_TEST_TIERS}")
  string(REPLACE ";" "|" areaRe "${SUB0ENGINE_TEST_AREAS}")
  foreach(test ${allTests})
    get_property(labels TEST ${test} PROPERTY LABELS)
    set(tiers ${labels})
    list(FILTER tiers INCLUDE REGEX "^(${tierRe})$")
    set(areas ${labels})
    list(FILTER areas INCLUDE REGEX "^area:(${areaRe})$")
    set(needs ${labels})
    list(FILTER needs INCLUDE REGEX "^needs:")
    list(LENGTH tiers nt)
    list(LENGTH areas na)
    if(NOT nt EQUAL 1 OR NOT na EQUAL 1)
      list(APPEND bad "${test} (labels: ${labels})")
    elseif(needs AND NOT "local" IN_LIST tiers)
      list(APPEND bad "${test}: needs:* requires tier local (labels: ${labels})")
    endif()
  endforeach()
  if(bad)
    string(REPLACE ";" "; " msg "${bad}")
    message(FATAL_ERROR "every test needs one tier (${SUB0ENGINE_TEST_TIERS}) and one area:<${SUB0ENGINE_TEST_AREAS}>, and any needs:* forces tier local: ${msg}")
  endif()
endfunction()
