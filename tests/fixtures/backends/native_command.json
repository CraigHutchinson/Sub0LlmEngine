{
  "cases": [
    {
      "name": "strata-defaults",
      "kind": "strata",
      "config": {
        "strataBin": "S/strata.exe",
        "strataProfile": "P/profile.json"
      },
      "windows": false,
      "comspec": "",
      "argv": [
        "S/strata.exe",
        "serve",
        "--profile",
        "P/profile.json",
        "--engine",
        "strata",
        "--host",
        "127.0.0.1",
        "--port",
        "8092"
      ]
    },
    {
      "name": "strata-port-slots",
      "kind": "strata",
      "config": {
        "strataBin": "S/strata.exe",
        "strataProfile": "P/profile.json",
        "port": 8123,
        "slots": 2,
        "host": "127.0.0.1"
      },
      "windows": false,
      "comspec": "",
      "argv": [
        "S/strata.exe",
        "serve",
        "--profile",
        "P/profile.json",
        "--engine",
        "strata",
        "--host",
        "127.0.0.1",
        "--port",
        "8123",
        "--parallel",
        "2"
      ]
    },
    {
      "name": "strata-batch-launcher-windows",
      "kind": "strata",
      "config": {
        "strataBin": "C:/Strata dir/strata.cmd",
        "strataProfile": "C:/p q/profile.json",
        "slots": 1
      },
      "windows": true,
      "comspec": "C:\\Windows\\system32\\cmd.exe",
      "argv": [
        "C:\\Windows\\system32\\cmd.exe",
        "/d",
        "/c",
        "\"C:/Strata dir/strata.cmd\" serve --profile \"C:/p q/profile.json\" --engine strata --host 127.0.0.1 --port 8092 --parallel 1"
      ]
    },
    {
      "name": "strata-batch-launcher-posix",
      "kind": "strata",
      "config": {
        "strataBin": "S/strata.cmd",
        "strataProfile": "P/profile.json"
      },
      "windows": false,
      "comspec": "",
      "argv": [
        "S/strata.cmd",
        "serve",
        "--profile",
        "P/profile.json",
        "--engine",
        "strata",
        "--host",
        "127.0.0.1",
        "--port",
        "8092"
      ]
    },
    {
      "name": "strata-exe-windows",
      "kind": "strata",
      "config": {
        "strataBin": "C:/Strata/strata.exe",
        "strataProfile": "C:/p/profile.json"
      },
      "windows": true,
      "comspec": "cmd.exe",
      "argv": [
        "C:/Strata/strata.exe",
        "serve",
        "--profile",
        "C:/p/profile.json",
        "--engine",
        "strata",
        "--host",
        "127.0.0.1",
        "--port",
        "8092"
      ]
    },
    {
      "name": "basalt",
      "kind": "basalt",
      "config": {
        "basaltBin": "B/basalt.exe",
        "basaltConfig": "C/basalt.json"
      },
      "windows": false,
      "comspec": "",
      "argv": [
        "B/basalt.exe",
        "serve",
        "--config",
        "C/basalt.json"
      ]
    },
    {
      "name": "basalt-bat-windows",
      "kind": "basalt",
      "config": {
        "basaltBin": "C:/Basalt/basalt.BAT",
        "basaltConfig": "C:/my config/basalt.json"
      },
      "windows": true,
      "comspec": "",
      "argv": [
        "cmd.exe",
        "/d",
        "/c",
        "C:/Basalt/basalt.BAT serve --config \"C:/my config/basalt.json\""
      ]
    }
  ],
  "quoting": [
    {
      "in": "plain",
      "out": "plain"
    },
    {
      "in": "a b",
      "out": "\"a b\""
    },
    {
      "in": "",
      "out": "\"\""
    },
    {
      "in": "c\"d",
      "out": "c\\\"d"
    },
    {
      "in": "e\\",
      "out": "e\\"
    },
    {
      "in": "e\\ f",
      "out": "\"e\\ f\""
    },
    {
      "in": "say \"hi there\"",
      "out": "\"say \\\"hi there\\\"\""
    },
    {
      "in": "tab\tx",
      "out": "\"tab\tx\""
    },
    {
      "in": "C:\\Program Files\\x\\",
      "out": "\"C:\\Program Files\\x\\\\\""
    }
  ]
}
